---
import { Sun, Moon } from '@lucide/astro';
const { pathname } = Astro.url;
---

<header>
	<a href="/" class="home">Julien Lach</a>
	<nav>
		<a href="/" class={pathname === '/' ? 'active' : ''}>Projects</a>
		<a href="/about" class={pathname.startsWith('/about') ? 'active' : ''}>About</a>
		<button id="theme-toggle" aria-label="Toggle theme">
			<!-- Sun: visible in dark mode -->
			<Sun id="icon-sun" size={16} stroke-width={1.5} />
			<!-- Moon: visible in light mode -->
			<Moon id="icon-moon" size={16} stroke-width={1.5} />
		</button>
	</nav>
</header>

<script>
  const btn = document.getElementById('theme-toggle');
  const root = document.documentElement;

  btn?.addEventListener('click', () => {
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    localStorage.setItem('theme', next);
  });
</script>

<style>
	header {
		max-width: 680px;
		margin: 0 auto;
		padding: 1.5rem;
		display: flex;
		justify-content: space-between;
		align-items: center;
		position: relative;
	}
	header::after {
		content: '';
		position: absolute;
		bottom: 0;
		left: 1.5rem;
		right: 1.5rem;
		border-bottom: 1px solid var(--border);
	}
	.home {
		text-decoration: none;
		color: var(--fg);
		font-weight: normal;
	}
	.home:hover {
		color: var(--accent);
	}
	nav {
		display: flex;
		gap: 1.5rem;
		align-items: center;
	}
	nav a {
		text-decoration: none;
		color: var(--dim);
		line-height: 1;
	}
	nav a:hover {
		color: var(--accent);
	}
	nav a.active {
		color: var(--accent);
	}
	#theme-toggle {
		background: none;
		border: none;
		color: var(--dim);
		cursor: pointer;
		padding: 0;
		position: relative;
		width: 16px;
		height: 16px;
	}
	#theme-toggle:hover {
		color: var(--fg);
	}

	:global(#icon-sun),
	:global(#icon-moon) {
		position: absolute;
		top: 0;
		left: 0;
		transition: opacity 0.25s ease, transform 0.25s ease;
	}

	:global(:root[data-theme="dark"]) #icon-moon {
		opacity: 0;
		transform: scale(0.7);
		pointer-events: none;
	}
	:global(:root[data-theme="light"]) #icon-sun {
		opacity: 0;
		transform: scale(0.7);
		pointer-events: none;
	}
</style>
