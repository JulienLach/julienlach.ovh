---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import { Terminal, Code, PenLine, ChevronRight } from '@lucide/astro';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="About - Julien Lach" description="About Julien Lach" />
	</head>
	<body>
		<Header />
		<main>
            <br>
			<p>
				I'm a software developer based in France, focused on building tools, workflows, automation and web applications that solve real business problems.
			</p>

			<p>
				I work mainly with TypeScript, Node.js, React, PostgreSQL, Docker, Ansible and GitHub Actions. I'm drawn to practical tools that make day-to-day work less painful, especially for teams and companies going through digitalization.
			</p>
            <p>
                
            </p>

			<h2>Working with</h2>

			<ul class="tech-list">
				<li>JavaScript</li>
				<li>TypeScript</li>
				<li>NodeJS</li>
				<li>Express.js</li>
				<li>React</li>
				<li>Vite</li>
				<li>React Native</li>
				<li>Postgres</li>
				<li>MySQL</li>
				<li>Docker</li>
				<li>Portainer</li>
				<li>Traefik</li>
				<li>Linux</li>
                <li>Debian/Fedora</li>
				<li>Bash</li>
				<li>Ansible</li>
				<li>Git</li>
				<li>GitHub Actions</li>
				<li>Claude Code CLI</li>
				<li>Obsidian</li>
			</ul>

			<h2>Currently learning</h2>

			<a href="https://roadmap.sh" target="_blank" rel="noopener" class="roadcard">
				<img src="https://roadmap.sh/card/tall/66e69402f34c8868ec5733a0?variant=dark&roadmaps=full-stack%2Cdevops" alt="roadmap.sh" />
			</a>
			<p>
				Always happy to collaborate or talk about code.
			</p>
			<p>
				<a href="https://github.com/JulienLach" target="_blank" rel="noopener" class="github-link">
					<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
						<path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/>
					</svg>
					GitHub →
				</a>
			</p>
		</main>
	</body>
</html>

<style>
	h1 {
		margin-top: 1rem;
		margin-bottom: 1.5rem;
	}
	h2 {
		margin-top: 2rem;
		margin-bottom: 0.5rem;
	}
	.tech-list {
		list-style: none;
		padding: 0;
		margin: 0.5rem 0 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}
	.tech-list li {
		font-size: 0.8em;
		color: var(--dim);
		border: 1px solid var(--border);
		border-radius: 4px;
		padding: 0.15em 0.5em;
	}
	.setup-list {
		list-style: none;
		padding: 0;
		margin: 0.5rem 0 0;
		display: flex;
		flex-direction: row;
		flex-wrap: wrap;
		gap: 1.2rem;
	}
	.setup-list li {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		color: var(--dim);
		font-size: 0.95em;
	}
	.setup-list li svg {
		flex-shrink: 0;
	}
	.roadcard {
		display: inline-block;
		margin-top: 0.5rem;
	}
	.roadcard img {
		width: 230px;
	}
.github-link {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
	}
</style>
